+// D4b (pre-registro.md §11.12): limite POR TERMO da conica, Lc = 2^18 - 1, exato
+// em float32. O backward per-splat soma exatamente UM termo por tile tocado
+// (PIXEL_BATCH_SIZE = TILE_SIZE; cada gaussiana do tile e tratada uma vez), e o
+// numero de tiles da grade e <= 2^13 (verificacao V0): |acumulado| <= 2^13 *
+// (2^18 - 1) = 2147475456 < 2^31 - 1. O acumulador da conica NUNCA estoura.
+// NAO usar D4_LIM / 2^13 = 262143.984375: round() o leva a 262144, e
+// 2^13 * 262144 = 2^31 estouraria. clamp POR TERMO e funcao pura do termo e
+// preserva a associatividade; continua PROIBIDO saturar o acumulador.
+// Opacidade, xy e rgb continuam com d4_quantizar e D4_LIM, como em D4.
+static const float D4B_LIM_CONICA = 262143.0;
+
+int d4b_quantizar_conica(float v, float escala)
+{
+    return int(round(clamp(v * escala, -D4B_LIM_CONICA, D4B_LIM_CONICA)));
+}
+
 float2 d4_desq_xy(int2 q)
 {
     return float2(float(q.x) * D4_INV_XY_X, float(q.y) * D4_INV_XY_Y);

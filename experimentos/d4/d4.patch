diff --git a/vksplat/slang/d4_fixed_point.slang b/vksplat/slang/d4_fixed_point.slang
new file mode 100644
index 0000000..ae70084
--- /dev/null
+++ b/vksplat/slang/d4_fixed_point.slang
@@ -0,0 +1,73 @@
+// d4_fixed_point.slang -- degrau D4 do TCC (reprodutibilidade em treino de 3DGS)
+//
+// Acumulacao em PONTO FIXO dos 9 gradientes do backward per-splat. Substitui a
+// adicao atomica em float32 (nao associativa) por adicao atomica inteira de 32
+// bits (OpAtomicIAdd), que e modular 2^32 e portanto associativa e comutativa:
+// o resultado independe da ordem das invocacoes.
+//
+// Especificacao vinculante: pre-registro.md §11 do repositorio do TCC
+// (github.com/fabio-gabriel/tcc). Base: tag D3, d222c47182f5917be0cc209f19d3257e1ebad17e.
+//
+// Incluido por: alphablend_shader_bwd_per_splat.slang (produtor),
+// fused_projection_backward_optimizer.slang e default.slang (consumidores).
+// Fonte UNICA das escalas: escala divergente entre produtor e consumidor seria
+// erro silencioso de correcao. NAO editar sem novo adendo datado.
+//
+// Escalas: s = floor(log2(2^30 / max observado)), dados de 3 execucoes x 16
+// steps em D3 (dados/gradientes/ no repositorio do TCC). Literais gerados por
+// script e conferidos: cada um le exatamente como 2^s / 2^-s em float32.
+
+#ifndef D4_FIXED_POINT_SLANG
+#define D4_FIXED_POINT_SLANG
+
+static const float D4_ESC_XY_X     = 17592186044416.0;  // 2^44
+static const float D4_ESC_XY_Y     = 17592186044416.0;  // 2^44
+static const float D4_ESC_CONIC_0  = 262144.0;  // 2^18
+static const float D4_ESC_CONIC_1  = 262144.0;  // 2^18
+static const float D4_ESC_CONIC_2  = 1048576.0;  // 2^20
+static const float D4_ESC_OPACITY  = 17179869184.0;  // 2^34
+static const float D4_ESC_RGB_R    = 137438953472.0;  // 2^37
+static const float D4_ESC_RGB_G    = 137438953472.0;  // 2^37
+static const float D4_ESC_RGB_B    = 274877906944.0;  // 2^38
+
+static const float D4_INV_XY_X     = 5.684341886080802e-14;  // 2^-44
+static const float D4_INV_XY_Y     = 5.684341886080802e-14;  // 2^-44
+static const float D4_INV_CONIC_0  = 3.814697265625e-06;  // 2^-18
+static const float D4_INV_CONIC_1  = 3.814697265625e-06;  // 2^-18
+static const float D4_INV_CONIC_2  = 9.5367431640625e-07;  // 2^-20
+static const float D4_INV_OPACITY  = 5.820766091346741e-11;  // 2^-34
+static const float D4_INV_RGB_R    = 7.275957614183426e-12;  // 2^-37
+static const float D4_INV_RGB_G    = 7.275957614183426e-12;  // 2^-37
+static const float D4_INV_RGB_B    = 3.637978807091713e-12;  // 2^-38
+
+// Maior float32 abaixo de 2^31 (espacamento 128 perto de 2^31); exato em float32.
+static const float D4_LIM = 2147483520.0;
+
+// Quantizacao de UM termo. round antes da conversao: OpConvertFToS trunca
+// ("round toward 0.0"), e truncar e vies sistematico. clamp antes da conversao:
+// fora do range, OpConvertFToS e comportamento indefinido (SPIR-V 1.6 rev. 8).
+// clamp POR TERMO e funcao pura do termo e preserva a associatividade da soma
+// modular. PROIBIDO: saturar o ACUMULADOR (laco de compare-exchange com
+// min/max sobre o valor armazenado) -- isso destroi a associatividade e o degrau.
+int d4_quantizar(float v, float escala)
+{
+    return int(round(clamp(v * escala, -D4_LIM, D4_LIM)));
+}
+
+float2 d4_desq_xy(int2 q)
+{
+    return float2(float(q.x) * D4_INV_XY_X, float(q.y) * D4_INV_XY_Y);
+}
+
+float4 d4_desq_conic_opacity(int4 q)
+{
+    return float4(float(q.x) * D4_INV_CONIC_0, float(q.y) * D4_INV_CONIC_1,
+                  float(q.z) * D4_INV_CONIC_2, float(q.w) * D4_INV_OPACITY);
+}
+
+float3 d4_desq_rgb(int r, int g, int b)
+{
+    return float3(float(r) * D4_INV_RGB_R, float(g) * D4_INV_RGB_G, float(b) * D4_INV_RGB_B);
+}
+
+#endif // D4_FIXED_POINT_SLANG
